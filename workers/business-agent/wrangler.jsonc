{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiamichi-business-agent",
  "main": "src/server.ts",
  "compatibility_date": "2025-12-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "app.kiamichibizconnect.com/*",
      "zone_name": "kiamichibizconnect.com"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "flagship": [
    {
      "binding": "FLAGS",
      "app_id": "ccdbbf6c-2b94-45b9-b5d5-e0c3d9c3fc5a"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kiamichi-biz-connect-db",
      "database_id": "e8b7b17a-a93b-4b61-92ad-80b488266e12"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "a5a33e270e4548548d43cf0554323e57"
    }
  ],
  "services": [
    {
      "binding": "ANALYZER",
      "service": "kiamichi-biz-ai-analyzer"
    },
    {
      "binding": "RAG_AGENT",
      "service": "purple-snow-f107-nlweb"
    },
    {
      "binding": "FACEBOOK_WORKER",
      "service": "kiamichi-facebook-worker"
    }
  ],
  "vars": {},
  "r2_buckets": [
    {
      "binding": "TEMPLATES",
      "bucket_name": "kiamichi-component-templates"
    },
    {
      "binding": "BUSINESS_ASSETS",
      "bucket_name": "kiamichi-business-assets"
    },
    {
      "binding": "IMAGES",
      "bucket_name": "kiamichi-biz-images"
    },
    {
      "binding": "BUSINESS_IMAGES",
      "bucket_name": "kiamichi-business-images"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "Chat",
        "class_name": "Chat"
      },
      {
        "name": "VoiceAgent",
        "class_name": "VoiceAgent"
      },
      {
        "name": "AtlasLive",
        "class_name": "AtlasLive"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Chat"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["VoiceAgent"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["AtlasLive"]
    }
  ],
  "env": {
    "preview": {
      "workers_dev": true,
      "routes": [],
      "vars": {},
      "ai": {
        "binding": "AI",
        "remote": true
      },
      "flagship": [
        {
          "binding": "FLAGS",
          "app_id": "ccdbbf6c-2b94-45b9-b5d5-e0c3d9c3fc5a"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kiamichi-biz-connect-preview-db",
          "database_id": "92abd5cd-befe-4196-9d77-00e8e8fe1810"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "d140f1a8e6114d19bc3e525be3ab0a9b"
        }
      ],
      "services": [
        {
          "binding": "ANALYZER",
          "service": "kiamichi-biz-ai-analyzer-preview"
        },
        {
          "binding": "FACEBOOK_WORKER",
          "service": "kiamichi-facebook-worker-preview"
        }
      ],
      "r2_buckets": [
        {
          "binding": "TEMPLATES",
          "bucket_name": "kiamichi-component-templates-preview"
        },
        {
          "binding": "BUSINESS_ASSETS",
          "bucket_name": "kiamichi-business-assets-preview"
        },
        {
          "binding": "IMAGES",
          "bucket_name": "kiamichi-biz-images-preview"
        },
        {
          "binding": "BUSINESS_IMAGES",
          "bucket_name": "kiamichi-business-images-preview"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "Chat",
            "class_name": "Chat"
          },
          {
            "name": "VoiceAgent",
            "class_name": "VoiceAgent"
          },
          {
            "name": "AtlasLive",
            "class_name": "AtlasLive"
          }
        ]
      }
    }
  }
}
